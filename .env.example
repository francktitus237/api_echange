# === APPLICATION ===
SECRET_KEY=CHANGE-ME-TO-A-RANDOM-50-CHAR-STRING
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine.com

# === BASE DE DONNÉES ===
USE_SQLITE=False
DB_NAME=forex_db
DB_USER=postgres
DB_PASSWORD=MOT-DE-PASSE-SECURISE
DB_HOST=db
DB_PORT=5432

# === REDIS ===
REDIS_URL=redis://redis:6379/0
USE_REDIS=True
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === RABBITMQ ===
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# === CLÉS API FOREX PROVIDERS (optionnel - ECB est gratuit) ===
FIXER_API_KEY=
OPENEXCHANGERATES_APP_ID=
EXCHANGERATE_API_KEY=

# === PARAMÈTRES FOREX ENGINE ===
FOREX_CACHE_TTL=300
FOREX_SPREAD_DEFAULT=0.015
FOREX_MARGIN_DEFAULT=0.005
FOREX_ANOMALY_THRESHOLD=0.20

# === CORS (ajouter URL de votre app mobile/frontend) ===
CORS_ALLOWED_ORIGINS=https://votre-domaine.com

# === SETUP SECRET (pour créer des clés API via endpoint) ===
SETUP_SECRET=changeme123
